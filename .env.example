# Copy to .env and fill in real values there — never commit real secrets.
# .env is gitignored. Revisit if this project moves to a dedicated secrets manager.

# DB connection string. Leave empty for local dev - defaults to SQLite at
# data/portfolio.db. Set to a Postgres URL only if concurrent writes become
# a real problem.
DATABASE_URL=

# Login/auth (external access is planned — see SECURITY.md)
AUTH_SECRET=

# Integrations used to pull automation metadata / links
GITHUB_TOKEN=
CLICKUP_API_TOKEN=

# Owner (existing Automator/Admin, matched by email) assigned to any
# brand-new automation `flask sync-github-org <owner>` finds - see that
# command's own docstring in src/app.py. Only matters for a repo that isn't
# already registered here; an existing one keeps its current owner on every
# re-run. Leave empty to make that command a no-op (it refuses to guess).
AUTOMATION_SYNC_OWNER_EMAIL=

# GitHub org/user account the "Оновити з GitHub" button on /automations
# scans, e.g. "giga-brdg". `flask sync-github-org` (the daily Railway cron)
# now reads this same variable too when its <owner> argument is omitted, so
# there's one source of truth instead of two - pass an explicit argument to
# the CLI only to sync a different org one-off. Leave empty to disable the
# button (it flashes an error instead of guessing which org to scan).
GITHUB_SYNC_ORG=

# Support/alerts channel (Telegram — see SUPPORT.md, OBSERVABILITY.md)
TELEGRAM_BOT_TOKEN=

# Registration approval bot (src/telegram_bot.py, run as its own process).
# Bot token from @BotFather; chat_id is the admin's own Telegram chat id
# (e.g. from @userinfobot) — only messages from this chat_id are ever acted
# on, everyone else's messages to the bot are ignored.
ADMIN_TELEGRAM_CHAT_ID=

# Read-only connection to ai-usage-collector's own Postgres (a separate
# Railway service, not this app's DB — see src/ai_usage.py and
# docs/token_usage_alerts_plan.md). Leave empty locally; the token-usage
# panel and `check-token-usage` both degrade to "no data" gracefully when
# unset.
AI_USAGE_DATABASE_URL=

# Token budget/spike alert thresholds (src/ai_usage.py) — picked "by eye"
# before any real spend history existed. Leave empty to use the defaults
# (3.0x spike, 80%/100% budget); override once real patterns justify it,
# no code change or release needed.
TOKEN_SPIKE_MULTIPLIER_DEFAULT=
TOKEN_BUDGET_WARN_THRESHOLD=
TOKEN_BUDGET_CRITICAL_THRESHOLD=
